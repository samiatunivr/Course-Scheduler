# University Course Scheduler — environment configuration
# Copy to .env and adjust for your environment (Hostinger: set via hPanel or .env file above public_html)

APP_NAME="University Course Scheduler"
APP_ENV=production
APP_URL=https://scheduler.example.edu
APP_DEBUG=false
APP_KEY=change-me-to-a-64-char-random-secret-used-for-sessions-and-tokens
APP_TIMEZONE=UTC

# MySQL 8+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=course_scheduler
DB_USERNAME=scheduler_user
DB_PASSWORD=secret

# AI provider (OpenAI-compatible chat completions endpoint)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_MAX_TOKENS=2048

# Mail (notifications)
MAIL_FROM=scheduler@example.edu
MAIL_FROM_NAME="Course Scheduler"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional webhook integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# SSO — SAML 2.0 (built-in SP; works with Azure AD / Entra ID, Google Workspace, Okta, ADFS)
SSO_SAML_ENABLED=false
# Values from your IdP's app registration:
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=          # PEM or bare base64 signing certificate
# SP values to register at the IdP (defaults derive from APP_URL):
#SAML_SP_ENTITY_ID=https://scheduler.example.edu/auth/saml/metadata
#SAML_ACS_URL=https://scheduler.example.edu/auth/saml/acs
# Auto-create unknown users on first SAML login with this role:
SAML_AUTO_PROVISION=false
SAML_DEFAULT_ROLE=viewer

# SSO — OAuth (optional, requires wiring an OAuth client)
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
LDAP_HOST=
LDAP_BASE_DN=
